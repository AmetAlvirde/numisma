{
  "name": "numisma",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "bun packages/tui/src/app.ts",
    "report": "tsx packages/tui/src/report.ts",
    "smoke:tui": "bun packages/tui/src/smoke-openTui.ts",
    "typecheck": "pnpm --filter @numisma/engine run typecheck && pnpm --filter @numisma/tui run typecheck",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
