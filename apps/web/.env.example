# @numisma/web environment. Copy to apps/web/.env (git-ignored) for local dev.
# Never commit a real .env. Local throwaway values are enough to boot the app.
#
# --- HOSTED values are NOT sourced from here, and NOT readable from Vercel ----
# Vercel Production env vars are SENSITIVE BY DEFAULT: injected into deployments
# but never readable back. `vercel env pull` returns them as EMPTY STRINGS,
# silently — so it cannot be used to source credentials for `auth:apply` or
# `push`, and the failure looks local (psql falls back to a unix socket and
# reports `database "<you>" does not exist`). Operator credentials live in
# git-ignored `.env.*.local` files and a password manager. See
# docs/hosted-cutover-runbook.md step 0.
#
# --- sslmode: a scheduled semantic change, not a preference -------------------
# Hosted strings use `?sslmode=require`. TODAY `pg` treats 'prefer'/'require'/
# 'verify-ca' as aliases for 'verify-full' (full cert + hostname validation) and
# warns on every run. In pg-connection-string v3 / pg v9 they adopt libpq
# semantics, which are WEAKER — `require` will stop validating the certificate.
# On that upgrade, change hosted strings to `sslmode=verify-full` explicitly, or
# they silently weaken with no error and no test failure.

# --- Projection DB (ADR-007 read-projection) -------------------------------
# READ-ONLY credential used by the web app's dashboard server function. Behind
# this URL the DB role must hold SELECT-only grants (see src/projection/schema.sql).
PROJECTION_DATABASE_URL=postgres://numisma_web:changeme@localhost:5432/numisma_projection

# WRITE credential used ONLY by the push shell (src/push/push.ts). SELECT+INSERT+UPDATE.
PROJECTION_WRITE_DATABASE_URL=postgres://numisma_push:changeme@localhost:5432/numisma_projection

# ONE-SHOT ADMIN credential used ONLY by `pnpm db:provision` (never held by a
# running service): a superuser or the table owner, able to CREATE the table and
# GRANT/REVOKE. Applies the DDL + ADR-007 two-role grants idempotently. See
# docs/projection-provisioning.md.
PROJECTION_ADMIN_DATABASE_URL=postgres://postgres@localhost:5432/numisma_projection

# Role NAMES the grants target (must match the roles behind the URLs above).
# Optional — these are the defaults. Must match ^[a-z_][a-z0-9_]*$.
PROJECTION_WRITER_ROLE=numisma_push
PROJECTION_READER_ROLE=numisma_web

# --- Auth DB (Better Auth) --------------------------------------------------
# SEPARATE database, RW. MUST be disjoint from the projection DB above — Better
# Auth never touches PROJECTION_DATABASE_URL.
AUTH_DATABASE_URL=postgres://numisma_auth:changeme@localhost:5432/numisma_auth

# --- Better Auth ------------------------------------------------------------
# Generate a secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# --- Single-tenant seed account (ADR-007) -----------------------------------
# The product is single-tenant: open signup is DISABLED at the auth server. The
# one account is established deterministically by `pnpm --filter @numisma/web
# auth:seed` from these values (idempotent — re-running never adds a second
# account). See docs/projection-provisioning.md.
NUMISMA_SEED_EMAIL=operator@example.com
NUMISMA_SEED_PASSWORD=change-me-a-strong-password
# Optional display name; defaults to the email when unset.
NUMISMA_SEED_NAME=Operator
