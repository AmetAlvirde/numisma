# Local env — never commit real credentials.
.env
.env.local

# TanStack Router generated route tree. Committed (not ignored) so a fresh
# checkout / CI can `typecheck` without a generate step — it is deterministic,
# machine-independent, and `@ts-nocheck`. `vite dev` / `vite build` regenerate it
# on route changes; commit the refreshed file alongside the route change.

# Build / deploy output.
.output/
.nitro/
.tanstack/
.vercel/
.vinxi/

# Better Auth CLI generated migration.
better-auth.schema.sql
.vercel
.env*.local
